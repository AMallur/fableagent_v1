# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Generate strong random values for the two secrets, e.g.:
#   openssl rand -hex 32

# --- local docker-compose Postgres (dev/staging only — see docker-compose.yml) ---
POSTGRES_PASSWORD=

# --- Cloud SQL (HA, automated backups) instead of local Postgres — only used
#     by docker-compose.cloudsql.yml, not the default docker-compose.yml.
#     Provision first: PROJECT_ID=... DB_PASSWORD=... bash db/provision_cloudsql.sh
#     which prints these two values. ---
CLOUDSQL_INSTANCE_CONNECTION_NAME=
CLOUDSQL_PASSWORD=

# --- required in production; the app refuses to boot without these ---
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Every secret also supports a mounted-file form, for example:
# SESSION_SECRET_FILE=/run/secrets/session_secret
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key
# DATABASE_URL_FILE=/run/secrets/database_url

# --- Caddy's TLS certificate is issued for this domain ---
DOMAIN=

# --- SMTP: leave blank until a BAA is signed with your email provider.
#     Notifications remain queued (and are not marked sent) until this is set. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_PASS_FILE=/run/secrets/smtp_password
SMTP_FROM=

# --- Embedded SFTP resource limits ---
SFTP_MAX_CONNECTIONS=100
SFTP_MAX_UPLOAD_BYTES=104857600

# --- Document storage: leave blank to use local disk (fine for one instance
#     with a persistent volume; not fine once you run more than one). Set
#     GCS_DOCUMENT_BUCKET to move appeal packets/letters to Cloud Storage.
#     On GCE, leave GOOGLE_APPLICATION_CREDENTIALS blank too — the VM's
#     attached service account is used automatically. Elsewhere, point it at
#     a mounted service-account key file. ---
GCS_DOCUMENT_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AWS deployment (docker-compose.aws.yml / ECS). On ECS or EC2, grant the
#     task/instance role S3+KMS access; never put AWS access keys in .env. ---
AWS_REGION=
AWS_DOCUMENT_BUCKET=
AWS_DOCUMENT_KMS_KEY_ID=
DB_HOST=
DB_PORT=5432
DB_NAME=fableagent
DB_ADMIN_USER=fableadmin
DB_ADMIN_PASSWORD=
DB_RUNTIME_USER=fable_runtime
DB_RUNTIME_PASSWORD=
